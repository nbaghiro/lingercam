{
    "name": "api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "DEV_ROUTES=1 node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.device --env-file-if-exists=../../.env.r2 --watch src/server.ts",
        "start": "node --env-file-if-exists=../../.env src/server.ts",
        "seed": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.device --env-file-if-exists=../../.env.r2 src/seed.ts",
        "review-seed": "node --env-file-if-exists=../../.env src/review.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "node --env-file-if-exists=../../.env src/db.ts",
        "db:studio": "drizzle-kit studio --port 8178",
        "typecheck": "tsc",
        "test": "vitest run"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1161.0",
        "@aws-sdk/s3-request-presigner": "^3.1161.0",
        "@hono/node-server": "^2.1.5",
        "@linger/core": "workspace:*",
        "@sentry/node": "^11.11.0",
        "drizzle-orm": "^0.45.4",
        "expo-server-sdk": "^8.0.0",
        "hono": "^4.13.16",
        "nodemailer": "^10.3.1",
        "pg-boss": "^12.38.0",
        "postgres": "^3.4.9",
        "sharp": "^0.35.5",
        "stripe": "^23.1.0",
        "thumbhash": "^0.1.1",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/node": "^26.0.0",
        "@types/nodemailer": "^8.0.2",
        "drizzle-kit": "^0.31.11",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
