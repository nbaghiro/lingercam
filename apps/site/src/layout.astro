---
interface Props {
    title?: string;
    description?: string;
    /** Set by Astro for Markdown pages. */
    frontmatter?: { title: string; description: string; updated?: string };
}

const { frontmatter } = Astro.props;
const pageTitle = Astro.props.title ?? frontmatter?.title;
const title = pageTitle ? `${pageTitle} · LingerCam` : "LingerCam, the shared event camera";
const description =
    Astro.props.description ??
    frontmatter?.description ??
    "Every guest gets a camera. Guests scan a code and start shooting, and the whole event arrives at once at the reveal.";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const appStoreUrl = import.meta.env.PUBLIC_APP_STORE_URL ?? "/support/#get-the-app";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#0D0D0D" />
        <link rel="canonical" href={canonical} />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="LingerCam" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..500;1,6..72,300..500&display=swap"
            rel="stylesheet"
        />
        <link
            rel="preload"
            href="/fonts/Pretendard-Regular.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
    </head>
    <body>
        <header class="nav">
            <a class="brand" href="/" aria-label="LingerCam home">
                <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true">
                    <circle
                        cx="12"
                        cy="16"
                        r="9"
                        fill="none"
                        stroke="#F3F1EC"
                        stroke-width="2.2"
                    ></circle>
                    <circle cx="20" cy="16" r="9" fill="#F3F1EC" fill-opacity=".9"></circle>
                </svg>
                LingerCam
            </a>
            <nav class="links" aria-label="Sections">
                <a href="/#setup">How it works</a>
                <a href="/#shoot">Guests</a>
                <a href="/#reveal">The reveal</a>
                <a href="/pricing/">Pricing</a>
                <a href="/#faq">Questions</a>
            </nav>
            <a class="store" href={appStoreUrl}>
                <svg
                    width="14"
                    height="16"
                    viewBox="0 0 14 17"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path d="M11.6 9c0-2 1.6-2.9 1.7-3-1-1.4-2.4-1.6-2.9-1.6-1.2-.1-2.4.7-3 .7s-1.6-.7-2.6-.7C3.5 4.4 2.2 5.2 1.5 6.4c-1.4 2.4-.4 6 1 8 .7 1 1.4 2 2.5 2s1.4-.6 2.6-.6 1.5.6 2.6.6 1.8-1 2.4-2c.8-1.1 1.1-2.2 1.1-2.3 0 0-2.1-.8-2.1-3.1ZM9.6 3c.5-.7.9-1.6.8-2.5-.8 0-1.8.5-2.3 1.2-.5.6-1 1.5-.8 2.4.9.1 1.8-.4 2.3-1.1Z"></path>
                </svg>
                App Store
            </a>
        </header>

        {frontmatter ? (
            <main class="prose">
                <h1>{frontmatter.title}</h1>
                {frontmatter.updated && <p class="updated">Last updated {frontmatter.updated}</p>}
                <slot />
            </main>
        ) : (
            <main>
                <slot />
            </main>
        )}

        <footer class="foot">
            <div class="foot-in">
                <div class="foot-brand">
                    <a class="brand" href="/">
                        <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true">
                            <circle
                                cx="12"
                                cy="16"
                                r="9"
                                fill="none"
                                stroke="#F3F1EC"
                                stroke-width="2.2"
                            ></circle>
                            <circle cx="20" cy="16" r="9" fill="#F3F1EC" fill-opacity=".9"></circle>
                        </svg>
                        LingerCam
                    </a>
                    <p>LingerCam is made by GalleoApp, Inc.</p>
                </div>
                <nav class="foot-links" aria-label="Legal and help">
                    <a href="/pricing/">Pricing</a>
                    <a href="/support/">Support</a>
                    <a href="/privacy/">Privacy</a>
                    <a href="/terms/">Terms</a>
                    <a href="/delete-account/">Delete account</a>
                    <a href="mailto:support@lingercam.app">support@lingercam.app</a>
                </nav>
            </div>
            <p class="fine">
                © {year} GalleoApp, Inc. Placeholder photos from{" "}
                <a href="https://www.pexels.com">Pexels</a>.
            </p>
        </footer>
    </body>
</html>

<style is:global>
    @font-face {
        font-family: "Pretendard";
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/Pretendard-Regular.woff2") format("woff2");
    }
    @font-face {
        font-family: "Pretendard";
        font-weight: 500;
        font-display: swap;
        src: url("/fonts/Pretendard-Medium.woff2") format("woff2");
    }
    @font-face {
        font-family: "Pretendard";
        font-weight: 600;
        font-display: swap;
        src: url("/fonts/Pretendard-SemiBold.woff2") format("woff2");
    }
    @font-face {
        font-family: "Pretendard";
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/Pretendard-Bold.woff2") format("woff2");
    }
    :root {
        --bg: #0d0d0d;
        --surface: #1c1c19;
        --raised: #262622;
        --line: rgba(255, 255, 255, 0.08);
        --text: #f3f1ec;
        --muted: #aaa79f;
        --faint: #6d6b65;
        --candle: #e9c99a;
        --serif: "Newsreader", Georgia, serif;
        --sans: "Pretendard", -apple-system, system-ui, sans-serif;
        /* Device scale: screens are laid out at iPhone 16 Pro points (402 x 874) and scaled down. */
        --s: 0.74;
        color-scheme: dark;
    }
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }
    html {
        scroll-behavior: smooth;
        scroll-padding-top: 72px;
    }
    body {
        background: var(--bg);
        color: var(--text);
        font: 16px/1.55 var(--sans);
        -webkit-font-smoothing: antialiased;
    }
    h1,
    h2,
    h3 {
        text-wrap: balance;
    }
    p,
    figcaption {
        text-wrap: pretty;
    }
    button {
        font: inherit;
        color: inherit;
        cursor: pointer;
        border: 0;
        background: none;
    }
    :focus-visible {
        outline: 2px solid var(--candle);
        outline-offset: 3px;
    }
    img {
        display: block;
    }
    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
            transition-duration: 1ms !important;
            animation-duration: 1ms !important;
        }
    }

    .nav {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px clamp(16px, 4vw, 48px);
        background: rgba(13, 13, 13, 0.82);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--line);
    }
    .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font: 400 29px/1 var(--serif);
        letter-spacing: -0.01em;
        color: inherit;
        text-decoration: none;
    }
    .links {
        display: flex;
        gap: 34px;
        font-size: 12.5px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #d8d5ce;
    }
    .links a {
        color: inherit;
        text-decoration: none;
    }
    .links a:hover {
        color: var(--text);
    }
    .store {
        color: inherit;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 10px 16px;
        font-weight: 500;
    }
    @media (max-width: 860px) {
        .links {
            display: none;
        }
    }

    .foot {
        margin-top: 96px;
        border-top: 1px solid var(--line);
        padding: 48px clamp(16px, 4vw, 48px) 56px;
        color: var(--muted);
        font-size: 14px;
    }
    .foot-in {
        max-width: 1560px;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 28px 48px;
    }
    .foot-brand {
        display: grid;
        gap: 12px;
    }
    .foot-brand .brand {
        font-size: 24px;
        color: var(--text);
    }
    .foot-links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 28px;
        align-content: start;
    }
    .foot a {
        color: inherit;
    }
    .foot-links a {
        text-decoration: none;
    }
    .foot-links a:hover {
        color: var(--text);
    }
    .fine {
        max-width: 1560px;
        margin: 32px auto 0;
        color: var(--faint);
        font-size: 12.5px;
    }

    .prose {
        max-width: 720px;
        margin: 0 auto;
        padding: 64px 16px 0;
        color: #d8d5ce;
        font-size: 16.5px;
        line-height: 1.65;
    }
    .prose h1 {
        font: 350 clamp(38px, 5vw, 56px)/1.05 var(--serif);
        letter-spacing: -0.02em;
        color: var(--text);
    }
    .prose .updated {
        color: var(--faint);
        font-size: 14px;
        margin-top: 12px;
    }
    .prose h2 {
        font: 400 28px/1.15 var(--serif);
        letter-spacing: -0.01em;
        color: var(--text);
        margin: 44px 0 12px;
    }
    .prose h3 {
        font-size: 17px;
        font-weight: 600;
        color: var(--text);
        margin: 28px 0 8px;
    }
    .prose p,
    .prose ul,
    .prose ol {
        margin-top: 14px;
    }
    .prose ul,
    .prose ol {
        padding-left: 22px;
    }
    .prose li + li {
        margin-top: 6px;
    }
    .prose a {
        color: var(--text);
        text-underline-offset: 3px;
    }
    .prose strong {
        color: var(--text);
        font-weight: 600;
    }
    .prose blockquote {
        margin-top: 28px;
        padding: 16px 18px;
        border-radius: 16px;
        background: #1a1a18;
        border: 1px solid var(--line);
        color: var(--muted);
        font-size: 15px;
    }
    .prose blockquote p:first-child {
        margin-top: 0;
    }
</style>
