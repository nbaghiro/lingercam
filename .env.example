# Copy to .env for local development. Every value here works with `docker compose up -d`.
# Production values are set in the Render dashboard (see render.yaml).

# API
NODE_ENV=development
PORT=8171
API_URL=http://localhost:8171
SITE_URL=http://localhost:8170
JOIN_URL=http://localhost:8173
# Optional. The guest web app's index.html, which /v1/e/:code/page fills with an event's link
# preview. Defaults to JOIN_URL/index.html.
JOIN_INDEX_URL=
CORS_ORIGINS=http://localhost:8173,http://localhost:8170
SESSION_SECRET=local-development-only
# The demo sign-in and the development purchase claim. Never set in production.
DEV_ROUTES=1
# The App Review login: signing in with REVIEW_EMAIL takes REVIEW_CODE and sends no email.
# `pnpm --filter api review-seed` gives it a live event (RVW4PP), a revealed one and a draft.
REVIEW_EMAIL=
REVIEW_CODE=
# Where reports of photos reach Linger. Defaults to support@lingercam.app.
MODERATION_EMAIL=

# Postgres (docker compose)
DATABASE_URL=postgres://linger:linger@localhost:8172/linger
TEST_DATABASE_URL=postgres://linger:linger@localhost:8172/linger_test

# Object storage: RustFS locally, Cloudflare R2 in production
S3_ENDPOINT=http://localhost:8174
S3_REGION=auto
S3_BUCKET=linger
S3_TEST_BUCKET=linger-test
S3_ACCESS_KEY_ID=linger
S3_SECRET_ACCESS_KEY=linger-local
S3_FORCE_PATH_STYLE=true
# Optional. Where signed photo URLs point, when devices can't reach S3_ENDPOINT. For a phone or an
# emulator on this network, use this Mac's LAN address, for example http://192.168.1.20:8174.
S3_PUBLIC_ENDPOINT=

# Email: Mailpit locally (web UI on 8176)
SMTP_URL=smtp://localhost:8177
MAIL_FROM="LingerCam <hello@lingercam.app>"

# Optional. Without these, local stand-ins are used (see .docs/architecture.md).
EXPO_ACCESS_TOKEN=
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. Error tracking for the API; nothing is sent while it's empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# App (Expo inlines EXPO_PUBLIC_* at build time)
EXPO_PUBLIC_API_URL=http://localhost:8171
EXPO_PUBLIC_JOIN_URL=http://localhost:8173
EXPO_PUBLIC_SITE_URL=http://localhost:8170
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Store listings for the web's "Get the app" buttons; empty falls back to the support page.
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=
# Optional. Error tracking for the app and the guest web app; nothing is sent while it's empty.
EXPO_PUBLIC_SENTRY_DSN=

# Optional. `pnpm storage:r2` serves the local demo data from the lingercam-dev R2 bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
